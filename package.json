    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "LICENSE",
    "extract-contract.py"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "template",
    "boilerplate",
    "checkin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/magpie-plugin-template.git"
  },
  "bugs": {
    "url": "https://github.com/MYCF711/magpie-plugin-template/issues"
  },
  "homepage": "https://github.com/MYCF711/magpie-plugin-template#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4
  }
